APP_BIND=127.0.0.1
APP_PORT=8080
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=watch_together
POSTGRES_USER=watch
POSTGRES_PASSWORD=watch_local
DATABASE_URL=postgresql+psycopg://watch:watch_local@db:5432/watch_together
COOKIE_SECURE=false
SESSION_SECONDS=604800
ROOM_OWNER_TIMEOUT=120
WEB_CONCURRENCY=1
LOG_LEVEL=info
